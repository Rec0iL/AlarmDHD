<?xml version="1.0" encoding="utf-8"?>
<!-- Also the preview in the widget picker, so its text is a sample that render() always replaces. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/home_next_alarm"
                android:textColor="@color/widget_amber"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:autoSizeMaxTextSize="32sp"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/widget_sample_time"
                android:textColor="@color/widget_text" />

            <TextView
                android:id="@+id/widget_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/day_tomorrow"
                android:textColor="@color/widget_text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/widget_stop"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_button"
        android:fontFamily="sans-serif-medium"
        android:text="@string/widget_stop_today"
        android:textAllCaps="false"
        android:textColor="@color/widget_on_amber"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>

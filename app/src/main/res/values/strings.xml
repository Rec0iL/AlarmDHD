    <!-- Setup checks -->
    <string name="check_notifications">Notifications</string>
    <string name="check_notifications_why">Android shows the ring screen through a notification. Without this, your alarm can\'t appear on the lock screen.</string>
    <string name="check_notifications_action">Allow notifications</string>
    <string name="check_full_screen">Full-screen alarms</string>
    <string name="check_full_screen_why">This lets the alarm take over the screen when your phone is locked, instead of just showing a small notification.</string>
    <string name="check_full_screen_action">Open settings</string>
    <string name="check_over_apps">Show over other apps</string>
    <string name="check_over_apps_why">This lets the alarm fill the screen while you\'re using your phone too. Without it, you only get a small banner at the top. Find AlarmDHD in the list and turn it on.</string>
    <string name="check_over_apps_action">Open settings</string>
    <string name="check_over_apps_restricted">Switch greyed out? Android blocks this for apps that didn\'t come from an app store. Tap the switch once, then come back here and open App info. In its ⋮ menu, choose Allow restricted settings, then try the switch again.</string>
    <string name="check_over_apps_app_info">Open App info</string>
    <string name="check_exact_alarm">Exact alarms</string>
    <string name="check_exact_alarm_why">Without this, Android may delay your alarms by several minutes.</string>
    <string name="check_exact_alarm_action">Open settings</string>
    <string name="check_battery">Battery optimisation</string>
    <string name="check_battery_why">Battery saving can stop an alarm app from running overnight. Letting this one run freely uses almost no extra battery, because it sleeps until an alarm is due.</string>
    <string name="check_battery_action">Allow</string>
    <string name="check_volume">Alarm volume</string>
    <string name="check_volume_why">Your alarm volume is quite low. Alarm volume is separate from your media and ringtone volume.</string>
    <string name="check_volume_action">Set volume</string>

    <!-- Setup wizard -->
    <string name="setup_welcome_title">Welcome</string>
    <string name="setup_welcome_text">This alarm is made for people who take a while to wake up.</string>
    <string name="setup_welcome_points">• You pick a start time, and an end time if you want one.\n\n• Alarms ring every few minutes, without you setting each one.\n\n• Every snooze adds one more alarm on top. It never pushes the others back.\n\n• A small, unlosable game turns everything off for the day.</string>
    <string name="setup_start">Set it up</string>
    <string name="setup_disclaimer_title">One honest thing</string>
    <string name="setup_disclaimer_accept">I understand and agree</string>
    <string name="disclaimer_title">No guarantees</string>
    <string name="disclaimer_text">AlarmDHD is provided as is, without any warranty. Alarms can fail because of a bug, a phone setting, an update, a flat battery or how the app was set up. You use it at your own risk.\n\nTo the extent the law allows, the developer is not liable for you oversleeping or for anything that follows from it, such as being late or missing an appointment, a job or a flight, whether it was caused by user error or a bug.\n\nIf something really matters, set a second alarm on another device.</string>
    <string name="setup_continue">Continue</string>
    <string name="setup_skip">Skip for now</string>
    <string name="setup_skip_music">Skip, use alarm tones</string>
    <string name="setup_finish">Done</string>
    <string name="setup_music_title">Wake up to your music</string>
    <string name="setup_music_text">Optional. Add your music folder to wake up to a song, an .m3u playlist or a random track. If a song ever can\'t be played, a backup tone rings instead.</string>
    <string name="setup_test_title">Try a real alarm</string>
    <string name="setup_test_text">The only way to be sure is to hear it. It rings in 10 seconds, so you\'ll have time to lock your phone.</string>
    <string name="setup_test_started">Lock your phone now. It should ring within 10 seconds and show over the lock screen. Press I\'m up and finish the game to end the test.</string>
    <string name="setup_test_started_no_game">Lock your phone now. It should ring within 10 seconds and show over the lock screen. Press I\'m up and answer yes to end the test.</string>
    <string name="setup_test_action">Ring in 10 seconds</string>
